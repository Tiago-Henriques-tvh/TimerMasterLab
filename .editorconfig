# define code style rules for the project

root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true
max_line_length = 120

# Apply to all Kotlin source files
[*.{kt,kts}]
indent_size = 4
continuation_indent_size = 4

[*.{kt,kts}]
disabled_rules = standard:function-naming